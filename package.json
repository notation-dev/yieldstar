{
  "name": "yieldstar-packages",
  "version": "0.5.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notationlabs/yieldstar.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bundle": "bun --filter '*' build && tsc -b",
    "dts": "tsc -b",
    "dev": "concurrently -r npm:dev:dts npm:dev:bundle npm:dev:test",
    "dev:dts": "bun run dts --watch",
    "dev:bundle": "bun run bundle --watch",
    "dev:test": "vitest",
    "test": "vitest run",
    "test:node": "node ./node_modules/vitest/vitest.mjs run",
    "test:bun": "bun --bun ./node_modules/vitest/vitest.mjs run",
    "test:store-conformance-package": "bun scripts/smoke-store-conformance-package.ts",
    "start": "bun scripts/run-example.ts",
    "bump": "bunx bumpp --preid alpha -r",
    "prerelease": "pnpm i && bun bundle",
    "release": "bin/release.sh"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/inquirer": "^9.0.9",
    "concurrently": "^9.2.1",
    "inquirer": "^9.3.7",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  }
}
