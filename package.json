{
  "name": "yieldstar-packages",
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bundle": "bun --filter '*' build",
    "dts": "tsc -b ./tsconfig.packages.json",
    "dev": "concurrently -r npm:dev:dts npm:dev:bundle npm:dev:test",
    "dev:dts": "bun run dts --watch",
    "dev:bundle": "bun run bundle --watch",
    "dev:test": "bun test --watch",
    "start": "bun scripts/run-example.ts",
    "version": "bunx bumpp --preid alpha -r",
    "prerelease": "pnpm i && bun dts && bun bundle",
    "release": "bin/release.sh"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "@types/inquirer": "^9.0.7",
    "concurrently": "^9.1.2",
    "inquirer": "^9.2.23"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
